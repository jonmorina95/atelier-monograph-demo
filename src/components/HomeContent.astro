---
const base = import.meta.env.BASE_URL;
---
<section class="hero page-section">
  <div class="hero-meta meta">ARCHITECTURE / INTERIORS / URBANISM</div>
  <h1 class="display reveal">Architecture<br/>as measured space.</h1>
  <p class="lede reveal">A contemporary studio working across buildings, interiors and cultural projects.</p>
</section>
<section class="home-end page-section reveal"><p class="meta">STUDIO PROFILE</p><a href={`${base}about/`} class="display-sm">Context, material,<br/>and everyday life →</a></section>
<style>
.hero{min-height:100svh;display:grid;grid-template-rows:auto 1fr auto;gap:4rem}.hero-meta{text-align:right}.hero h1{align-self:center;max-width:11ch}.hero>.lede{justify-self:start}.home-end{min-height:70vh;display:flex;flex-direction:column;justify-content:space-between}.home-end a{align-self:flex-end;margin-top:20vh}@media(max-width:900px){.home-end{min-height:55vh}.home-end a{align-self:auto}}@media(max-width:767px){.hero{min-height:auto;padding-top:46px;grid-template-rows:auto auto auto;gap:3.2rem}.hero-meta{text-align:left}.hero h1{font-size:clamp(3rem,17vw,5rem)}.home-end a{margin-top:22vh}}
</style>
