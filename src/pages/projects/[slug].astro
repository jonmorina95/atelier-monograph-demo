---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
export function getStaticPaths(){ return projects.map(project => ({ params:{ slug: project.slug }, props:{ project } })); }
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const asset = (p:string) => `${base}${p}`;
---
<BaseLayout active="projects" title={`${project.title} — Studio Name`} description={project.statement}>
  <section class="detail-head page-section">
    <div class="meta-row"><span class="meta">PROJECT {project.index}</span><span class="meta">{project.location} · {project.year}</span></div>
    <h1 class="display reveal">{project.title}</h1>
  </section>

  <section class="hero-media">
    <div class="media"><img src={asset(project.cover)} alt={project.title} /></div>
    <div class="plate"><span class="meta">PLATE 01.0 — PRIMARY VIEW</span><span class="meta">STUDIO ARCHIVE</span></div>
  </section>

  <section class="story page-section">
    <aside class="project-sticky">
      <div><span class="meta">CONCEPT</span><p class="lede-small">{project.statement}</p></div>
      <dl>
        <div><dt>Location</dt><dd>{project.location}</dd></div>
        <div><dt>Type</dt><dd>{project.type}</dd></div>
        <div><dt>Status</dt><dd>{project.status}</dd></div>
        <div><dt>Area</dt><dd>{project.area}</dd></div>
      </dl>
      {project.pdf ? <a class="folio" href={asset(project.pdf)}>DOWNLOAD PROJECT PDF ↓</a> : <span class="folio disabled">PROJECT PDF / OPTIONAL</span>}
    </aside>

    <div class="project-content">
      <div class="media reveal"><img src={asset(project.gallery[0])} alt="Project context" loading="lazy" /></div>
      <div class="copy-block reveal"><span class="meta">MATERIAL / CONTEXT</span>{project.description.map((p:string)=><p>{p}</p>)}</div>
      <div class="paired">
        {project.gallery.slice(1,3).map((src:string, i:number)=><div class="media reveal"><img src={asset(src)} alt={`Project detail ${i+1}`} loading="lazy" /></div>)}
      </div>
      {project.gallery[3] && <div class="media wide reveal"><img src={asset(project.gallery[3])} alt="Project gallery" loading="lazy" /></div>}
      <div class="credits reveal">
        <span class="meta">PROJECT INFORMATION</span>
        <dl>{project.credits.map(([k,v]:[string,string])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
.detail-head{min-height:68vh;display:flex;flex-direction:column;justify-content:space-between}.meta-row,.plate{display:flex;justify-content:space-between;gap:1rem}.detail-head h1{max-width:9ch}.hero-media{border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.hero-media .media{border:0;aspect-ratio:16/8}.plate{padding:9px var(--page-pad);border-top:1px solid var(--line)}
.story{display:grid;grid-template-columns:minmax(250px,4fr) minmax(0,8fr);gap:clamp(28px,5vw,80px);align-items:start}.project-sticky{position:sticky;top:28px;display:grid;gap:2rem;padding-right:clamp(18px,2vw,30px);border-right:1px solid var(--line)}.lede-small{font-size:clamp(1.1rem,1.7vw,1.6rem);line-height:1.3;letter-spacing:-.02em;font-weight:300}.project-sticky dl,.credits dl{margin:0;border-top:1px solid var(--line)}.project-sticky dl div,.credits dl div{display:flex;justify-content:space-between;gap:1rem;padding:9px 0;border-bottom:1px solid var(--line)}dt{font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}dd{margin:0;text-align:right;font-size:.7rem;letter-spacing:.06em;text-transform:uppercase}.folio{display:block;border:1px solid var(--line);padding:14px;font-size:.64rem;letter-spacing:.16em;text-transform:uppercase}.folio:hover{background:var(--ink);color:var(--bg)}.folio.disabled{color:var(--muted)}.project-content{display:grid;gap:clamp(34px,5vw,72px)}.project-content>.media:first-child{aspect-ratio:16/10}.copy-block{display:grid;grid-template-columns:1fr 2fr;gap:2rem;padding:28px 0;border-block:1px solid var(--line)}.copy-block p{margin:0 0 1.2rem;color:var(--ink-2);font-size:1rem;line-height:1.7}.paired{display:grid;grid-template-columns:1fr 1fr;gap:18px}.paired .media{aspect-ratio:3/4}.wide{aspect-ratio:16/9}.credits{padding-top:20px}.credits>.meta{display:block;margin-bottom:18px}
@media(max-width:900px){.story{grid-template-columns:1fr}.project-sticky{position:static;border-right:0;border-bottom:1px solid var(--line);padding:0 0 30px}.copy-block{grid-template-columns:1fr 2fr}}
@media(max-width:767px){.detail-head{min-height:48vh}.meta-row,.plate{align-items:flex-start}.hero-media .media{aspect-ratio:4/3}.story{display:block}.project-content{padding-top:34px}.copy-block{grid-template-columns:1fr}.paired{grid-template-columns:1fr}.paired .media{aspect-ratio:4/5}}
</style>
