---
const { active = '', continuous = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const items = [
  ['HOME', continuous ? `${base}#home` : base, 'home'],
  ['PROJECTS', continuous ? `${base}#projects` : `${base}projects/`, 'projects'],
  ['ABOUT', continuous ? `${base}#about` : `${base}about/`, 'about'],
  ['CONTACT', continuous ? `${base}#contact` : `${base}contact/`, 'contact']
];
---
<aside class="sidebar" aria-label="Primary navigation">
  <a class="brand" href={base} aria-label="Studio Name home">
    <span>STUDIO</span><span>NAME</span>
  </a>
  <nav>
    {items.map(([label, href, section]) => (
      <a href={href} data-section-link={continuous ? section : undefined} class:list={{ active: active === label.toLowerCase() }}>{label}<span></span></a>
    ))}
  </nav>
  <div class="sidebar-foot">
    <span>ARCHITECTURE / INTERIORS</span>
    <span>PRISHTINA · 2026</span>
  </div>
</aside>

<header class="mobile-header">
  <a href={base} class="mobile-brand">STUDIO NAME</a>
  <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false">MENU</button>
</header>
<div class="mobile-menu" data-menu aria-hidden="true">
  <div class="mobile-menu-inner">
    {items.map(([label, href], i) => (
      <a href={href}><span class="meta">0{i + 1}</span><span>{label}</span></a>
    ))}
  </div>
</div>

<style>
.sidebar { position: fixed; z-index: 30; inset: 0 auto 0 0; width: var(--sidebar); border-right: 1px solid var(--line); background: var(--bg); padding: 28px 24px; display: flex; flex-direction: column; }
.brand { display: inline-flex; flex-direction: column; font-size: 1.05rem; line-height: .95; letter-spacing: -.03em; width: max-content; }
nav { margin-top: 22vh; display: grid; }
nav a { position: relative; padding: 10px 0; color: var(--muted); font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; display: flex; align-items: center; gap: 12px; transition: color .25s ease; }
nav a span { height: 1px; width: 0; background: currentColor; transition: width .35s var(--ease); }
nav a:hover, nav a.active { color: var(--ink); }
nav a.active span { width: 52px; }
.sidebar-foot { margin-top: auto; display: grid; gap: 6px; color: var(--muted); font-size: .56rem; letter-spacing: .16em; text-transform: uppercase; }
.mobile-header,.mobile-menu { display:none; }
@media (max-width: 767px) {
  .sidebar { display:none; }
  .mobile-header { display:flex; position:fixed; z-index:50; inset:0 0 auto 0; height:58px; background:rgba(17,18,19,.96); border-bottom:1px solid var(--line); align-items:center; justify-content:space-between; padding:0 18px; }
  .mobile-brand,.menu-toggle { font-size:.65rem; letter-spacing:.16em; text-transform:uppercase; }
  .menu-toggle { color:var(--ink); background:none; border:0; padding:12px 0; }
  .mobile-menu { display:block; position:fixed; z-index:40; inset:58px 0 0 0; background:var(--bg); transform:translateY(-105%); transition:transform 600ms var(--ease); pointer-events:none; border-top:1px solid var(--line); }
  .mobile-menu.open { transform:translateY(0); pointer-events:auto; }
  .mobile-menu-inner { display:grid; height:100%; align-content:center; }
  .mobile-menu a { display:grid; grid-template-columns:52px 1fr; align-items:baseline; padding:18px; border-bottom:1px solid var(--line); font-size:clamp(2.3rem,14vw,4.3rem); letter-spacing:-.04em; }
}
</style>

<script>
  const btn = document.querySelector('.menu-toggle');
  const menu = document.querySelector('[data-menu]');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'CLOSE' : 'MENU';
    menu?.setAttribute('aria-hidden', String(!open));
    document.body.style.overflow = open ? 'hidden' : '';
  });
</script>
