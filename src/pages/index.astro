---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/HomeContent.astro';
import ProjectsContent from '../components/ProjectsContent.astro';
import AboutContent from '../components/AboutContent.astro';
import ContactContent from '../components/ContactContent.astro';
---
<BaseLayout active="home" continuous title="Studio Name — Architecture">
  <div class="continuous-flow" data-continuous-flow>
    <section id="home" class="flow-stage" data-flow-section="home"><div class="flow-content"><HomeContent /></div></section>
    <section id="projects" class="flow-stage" data-flow-section="projects"><div class="flow-content"><ProjectsContent /></div></section>
    <section id="about" class="flow-stage" data-flow-section="about"><div class="flow-content"><AboutContent /></div></section>
    <section id="contact" class="flow-stage" data-flow-section="contact"><div class="flow-content"><ContactContent /></div></section>
  </div>
</BaseLayout>
<style>
.continuous-flow{isolation:isolate}.flow-stage{position:relative;z-index:1;--flow-in:1;--flow-out:0}.flow-content{position:relative;background:var(--bg);transform-origin:center top}.flow-stage:not(:first-child){margin-top:-12svh;padding-top:12svh}.flow-stage:nth-child(2){z-index:2}.flow-stage:nth-child(3){z-index:3}.flow-stage:nth-child(4){z-index:4}
html.has-continuous-flow .flow-stage:not(:first-child) .flow-content{opacity:calc(.96 + var(--flow-in) * .04);transform:translate3d(0,calc((1 - var(--flow-in)) * 24svh),0);clip-path:inset(calc((1 - var(--flow-in)) * 5%) 0 0 0);will-change:transform,opacity,clip-path}html.has-continuous-flow .flow-stage:not(:last-child) .flow-content{transform:none;opacity:calc(1 - var(--flow-out) * .8)}html.has-continuous-flow .flow-stage:not(:first-child):not(:last-child) .flow-content{transform:translate3d(0,calc((1 - var(--flow-in)) * 24svh),0);opacity:calc((.96 + var(--flow-in) * .04) * (1 - var(--flow-out) * .8))}
@media(min-width:768px) and (max-width:900px){html.has-continuous-flow .flow-stage:not(:first-child) .flow-content,html.has-continuous-flow .flow-stage:not(:first-child):not(:last-child) .flow-content{transform:translate3d(0,calc((1 - var(--flow-in)) * 16svh),0)}}@media(max-width:767px){.flow-stage:not(:first-child){margin-top:-7svh;padding-top:7svh}html.has-continuous-flow .flow-stage:not(:first-child) .flow-content{opacity:calc(.98 + var(--flow-in) * .02);transform:translate3d(0,calc((1 - var(--flow-in)) * 12svh),0);clip-path:none}html.has-continuous-flow .flow-stage:not(:last-child) .flow-content{transform:none;opacity:calc(1 - var(--flow-out) * .75)}html.has-continuous-flow .flow-stage:not(:first-child):not(:last-child) .flow-content{transform:translate3d(0,calc((1 - var(--flow-in)) * 12svh),0);opacity:calc((.98 + var(--flow-in) * .02) * (1 - var(--flow-out) * .75))}}@media(prefers-reduced-motion:reduce){.flow-stage:not(:first-child){margin-top:0;padding-top:0}.flow-content{clip-path:none!important;opacity:1!important;transform:none!important}}
</style>
