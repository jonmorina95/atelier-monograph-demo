---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/HomeContent.astro';
import ProjectsContent from '../components/ProjectsContent.astro';
import AboutContent from '../components/AboutContent.astro';
import ContactContent from '../components/ContactContent.astro';
---
<BaseLayout active="home" continuous title="VENT — Architecture">
  <div class="continuous-flow" data-continuous-flow>
    <section id="home" class="flow-stage" data-flow-section="home"><div class="flow-content"><HomeContent /></div></section>
    <section id="projects" class="flow-stage" data-flow-section="projects"><div class="flow-content"><ProjectsContent /></div></section>
    <section id="about" class="flow-stage" data-flow-section="about"><div class="flow-content"><AboutContent /></div></section>
    <section id="contact" class="flow-stage" data-flow-section="contact"><div class="flow-content"><ContactContent /></div></section>
  </div>
</BaseLayout>
<style>
.continuous-flow {
  isolation: isolate;
  --flow-overlap: 20svh;
  --flow-in-min-opacity: .96;
  --flow-out-opacity: .2;
}

.flow-stage { position: relative; z-index: 1; --flow-in: 1; --flow-out: 0; }
.flow-content { position: relative; background: var(--bg); transform-origin: center top; }
.flow-stage:not(:first-child) { margin-top: calc(var(--flow-overlap) * -1); }
.flow-stage:nth-child(2) { z-index: 2; }
.flow-stage:nth-child(3) { z-index: 3; }
.flow-stage:nth-child(4) { z-index: 4; }

html.has-continuous-flow .flow-stage:not(:first-child) .flow-content {
  opacity: calc(var(--flow-in-min-opacity) + var(--flow-in) * (1 - var(--flow-in-min-opacity)));
  transform: translate3d(0, calc((1 - var(--flow-in)) * var(--flow-overlap)), 0);
  will-change: transform, opacity;
}

html.has-continuous-flow .flow-stage:not(:last-child) .flow-content {
  opacity: calc(1 - var(--flow-out) * (1 - var(--flow-out-opacity)));
}

html.has-continuous-flow .flow-stage:not(:first-child):not(:last-child) .flow-content {
  opacity: calc((var(--flow-in-min-opacity) + var(--flow-in) * (1 - var(--flow-in-min-opacity))) * (1 - var(--flow-out) * (1 - var(--flow-out-opacity))));
}

@media (min-width: 768px) and (max-width: 900px) {
  .continuous-flow { --flow-overlap: 14svh; }
}

@media (max-width: 767px) {
  .continuous-flow { --flow-overlap: 9svh; --flow-in-min-opacity: .98; --flow-out-opacity: .25; }
}

@media (prefers-reduced-motion: reduce) {
  .flow-stage:not(:first-child) { margin-top: 0; }
  .flow-content { opacity: 1 !important; transform: none !important; }
}
</style>
