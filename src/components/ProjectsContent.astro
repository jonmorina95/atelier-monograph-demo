---
import { projects } from '../data/projects';
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base}${p}`;
---
<section class="projects-head page-section"><span class="meta">ARCHIVE / {projects.length.toString().padStart(2, '0')} PROJECTS</span><h1 class="display">PROJECTS</h1></section>
<section class="project-grid">{projects.map((p, i) => <a href={`${base}projects/${p.slug}/`} class:list={['tile', 'reveal', `tile-${i + 1}`]}><div class="tile-top"><span class="meta">{p.index}</span><span class="meta">{p.location}</span></div><div class="media"><img src={asset(p.cover)} alt={p.title} loading={i < 2 ? 'eager' : 'lazy'} /></div><div class="project-caption"><h2>{p.title}</h2><span class="meta">{p.type} · {p.year}</span></div></a>)}</section>
<style>.projects-head{min-height:46vh;display:flex;flex-direction:column;justify-content:space-between;align-items:flex-end}.projects-head .meta{align-self:flex-start}.project-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:1px;background:var(--line);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.tile{background:var(--bg);padding:20px;min-width:0}.tile-top{display:flex;justify-content:space-between;gap:1rem;margin-bottom:.6rem}.tile-1{grid-column:1/8}.tile-2{grid-column:8/13;padding-top:12vw}.tile-3{grid-column:1/5;padding-top:8vw}.tile-4{grid-column:5/13}.tile-1 .media,.tile-4 .media{aspect-ratio:16/10}.tile-2 .media,.tile-3 .media{aspect-ratio:3/4}.project-caption h2{font-size:.78rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;margin:0}@media(max-width:900px){.project-grid{grid-template-columns:1fr 1fr}.tile,.tile-1,.tile-2,.tile-3,.tile-4{grid-column:auto;padding:16px}.tile .media{aspect-ratio:4/5}}@media(max-width:767px){.projects-head{min-height:34vh;align-items:flex-start}.project-grid{grid-template-columns:1fr}.tile .media{aspect-ratio:4/3}.tile{border-bottom:1px solid var(--line)}}</style>
