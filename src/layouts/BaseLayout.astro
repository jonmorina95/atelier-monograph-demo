---
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';
const { title = 'Studio Name', description = 'Architecture studio portfolio', active = '', continuous = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111213" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <Sidebar active={active} continuous={continuous} />
      <main class="page-main"><slot /></main>
    </div>
    <script is:inline>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealEls = [...document.querySelectorAll('.reveal')];
      if (!reduced && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        }), { threshold: .12, rootMargin: '0px 0px -5% 0px' });
        revealEls.forEach((el) => io.observe(el));
      } else revealEls.forEach((el) => el.classList.add('is-visible'));

      if (!reduced && window.innerWidth >= 768) {
        const parallax = [...document.querySelectorAll('[data-parallax]')];
        let ticking = false;
        const update = () => {
          const vh = window.innerHeight;
          parallax.forEach((el) => {
            const rect = el.getBoundingClientRect();
            const speed = Number(el.dataset.parallax || .06);
            if (rect.bottom > 0 && rect.top < vh) {
              const offset = (rect.top - vh / 2) * speed;
              el.style.transform = `translate3d(0, ${offset}px, 0)`;
            }
          });
          ticking = false;
        };
        addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(update); ticking = true; } }, { passive: true });
        update();
      }

      const flow = document.querySelector('[data-continuous-flow]');
      if (flow && !reduced) {
        const stages = [...flow.querySelectorAll('[data-flow-section]')];
        const links = [...document.querySelectorAll('[data-section-link]')];
        let ticking = false;
        document.documentElement.classList.add('has-continuous-flow');
        const updateFlow = () => {
          const viewport = window.innerHeight;
          let activeStage = stages[0];
          let nearest = Infinity;
          stages.forEach((stage, index) => {
            const rect = stage.getBoundingClientRect();
            const incoming = index ? Math.min(1, Math.max(0, (viewport * .92 - rect.top) / (viewport * .55))) : 1;
            const next = stages[index + 1];
            const nextRect = next?.getBoundingClientRect();
            const outgoing = nextRect ? Math.min(1, Math.max(0, (viewport * .92 - nextRect.top) / (viewport * .55))) : 0;
            stage.style.setProperty('--flow-in', incoming.toFixed(3));
            stage.style.setProperty('--flow-out', outgoing.toFixed(3));
            const distance = Math.abs(rect.top - viewport * .28);
            if (distance < nearest) { nearest = distance; activeStage = stage; }
          });
          const current = activeStage?.dataset.flowSection;
          links.forEach((link) => link.classList.toggle('active', link.dataset.sectionLink === current));
          ticking = false;
        };
        addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(updateFlow); ticking = true; } }, { passive: true });
        addEventListener('resize', updateFlow, { passive: true });
        updateFlow();
      }
    </script>
  </body>
</html>
